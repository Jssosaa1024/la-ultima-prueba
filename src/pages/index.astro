---
import Base from '../layouts/Base.astro';
import Contador from '../ui/Contador';
---

<Base title="La Última Prueba">
  <main>
    <h1>La Última Prueba</h1>
    <p>Base del proyecto (T01): Astro + Preact + Signals.</p>
    <Contador client:load />
    <p>
      <a class="jugar" href="/jugar">
        Jugar
      </a>
    </p>
  </main>
</Base>

<style>
  .jugar {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.5rem;
    border-radius: 0.5rem;
    background: #e8a33d;
    color: #111418;
    font-weight: 600;
    text-decoration: none;
  }
</style>
