---
import Base from '../layouts/Base.astro';
import Ficha from '../ui/tema/Ficha';
import Sello from '../ui/tema/Sello';
import '../ui/botones.css';
import '../ui/tema.css';

/**
 * Portada (T41h): entrar al colegio a las 23:59. Fondo con la portería real (capturada con
 * `scripts/capturar-portada.ts`), luz de linterna y grano; a la izquierda el reloj, el título y
 * la historia; a la derecha la ficha del expediente con «Jugar» y la guía para docentes.
 *
 * Es HTML estático: Ficha y Sello (Preact) se dibujan en el build, sin `client:*`. Lo único que
 * corre en el navegador es el reloj (unas líneas). No se precarga el juego.
 */
const titulo = 'La Última Prueba';
const descripcion =
  'Tu proyecto de la feria de ciencias quedó encerrado en el colegio y a las 00:40 el archivo se borra. Escape room 3D de matemáticas: cinco salas, cinco máquinas y 40 minutos, en el celular y sin instalar nada.';
---

<Base
  title={titulo}
  description={descripcion}
  imagen="/portada/compartir-1200x630.jpg"
  imagenAlt="La portería del colegio de noche, con el título La Última Prueba y el reloj en 23:59."
  temaColor="#14110d"
>
  <main class="portada tema-archivo" aria-labelledby="portada-titulo">
    <picture class="portada-fondo">
      <source
        type="image/webp"
        srcset="/portada/porteria-960.webp 960w, /portada/porteria-1600.webp 1600w"
        sizes="(max-aspect-ratio: 16/9) 178vh, 100vw"
      />
      <img
        src="/portada/porteria-960.webp"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="portada-velo" aria-hidden="true"></div>

    <div class="portada-contenido">
      <header class="portada-relato">
        <p class="tema-etiqueta portada-ante">I. E. Los Almendros · Archivo escolar</p>
        <p class="portada-reloj" aria-hidden="true">
          <span>23</span>
          <span class="portada-dos-puntos">:</span>
          <span>59</span>
          <span class="portada-segundos">
            :<span data-segundos>00</span>
          </span>
        </p>
        <h1 id="portada-titulo" class="tema-titulo portada-titulo">
          {titulo}
        </h1>
        <p class="portada-gancho">
          <span class="solo-lector">Son las 23:59.</span>
          Tu proyecto de la feria de ciencias quedó encerrado en el colegio, y a las 00:40 el
          archivo se borra. Cinco salas, cinco máquinas y una voz en los parlantes que sabe por qué
          volviste.
        </p>
        <ul class="portada-datos">
          <li class="tema-etiqueta">40 minutos</li>
          <li class="tema-etiqueta">Solo o en grupo de 2 a 4</li>
          <li class="tema-etiqueta">En el celular, sin instalar ni crear cuenta</li>
        </ul>
        <button type="button" class="portada-trailer-abrir" data-trailer-abrir>
          <span aria-hidden="true">▶</span> Ver el tráiler{' '}
          <span class="portada-trailer-dur">50 s</span>
        </button>
      </header>

      <Ficha variante="renglones" pestana="Expediente 00:40" entra clase="portada-ficha">
        <Sello texto="Confidencial" decorativo golpe clase="portada-sello" />
        <p class="portada-ficha-nota">Caso abierto a las 23:59. Ciérralo antes de las 00:40.</p>
        <nav class="portada-acciones" aria-label="Empezar">
          <a class="boton boton-principal portada-jugar" href="/jugar">
            Jugar
          </a>
          <a class="boton boton-secundario portada-docentes" href="/docentes">
            Guía para docentes
          </a>
        </nav>
      </Ficha>

      <footer class="portada-pie">
        <p>Colegio y personajes ficticios · Para estudiantes de 9.° en adelante</p>
      </footer>
    </div>
  </main>

  <dialog
    class="portada-trailer tema-archivo"
    aria-label="Tráiler de La Última Prueba"
    data-trailer
  >
    <div class="portada-trailer-caja">
      <video
        class="portada-trailer-video"
        controls
        playsinline
        preload="none"
        poster="/trailer/trailer-poster.webp"
        data-trailer-video
      >
        <source
          src="/trailer/trailer-vertical.mp4"
          type="video/mp4"
          media="(orientation: portrait)"
        />
        <source src="/trailer/trailer-horizontal.mp4" type="video/mp4" />
      </video>
      <button
        type="button"
        class="boton boton-secundario portada-trailer-cerrar"
        data-trailer-cerrar
      >
        Cerrar
      </button>
    </div>
  </dialog>
</Base>

<script>
  // El reloj de la portada (decorativo, aria-hidden): los segundos avanzan desde 23:59:00.
  // Quieto si se pide menos movimiento.
  const segundos = document.querySelector('[data-segundos]');
  if (segundos && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const inicio = performance.now();
    window.setInterval(() => {
      const s = Math.floor((performance.now() - inicio) / 1000) % 60;
      segundos.textContent = String(s).padStart(2, '0');
    }, 1000);
  }

  // El tráiler: se abre en un diálogo y el video solo se descarga al abrirlo (preload="none").
  const dialogo = document.querySelector<HTMLDialogElement>('[data-trailer]');
  const video = document.querySelector<HTMLVideoElement>('[data-trailer-video]');
  const abrir = document.querySelector('[data-trailer-abrir]');
  if (dialogo && video && abrir) {
    abrir.addEventListener('click', () => {
      dialogo.showModal();
      void video.play().catch(() => {
        // Si el navegador no deja reproducir solo, quedan los controles del video.
      });
    });
    document
      .querySelector('[data-trailer-cerrar]')
      ?.addEventListener('click', () => dialogo.close());
    // Tocar fuera del video también cierra.
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo) dialogo.close();
    });
    dialogo.addEventListener('close', () => video.pause());
  }
</script>

<style>
  .portada {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    width: 100%;
    min-height: 100dvh;
    align-self: stretch;
    display: flex;
    overflow: hidden;
    background: var(--tema-noche);
  }

  /* ---------- Fondo: la portería, oscurecida, con linterna y grano ---------- */

  .portada-fondo,
  .portada-fondo img,
  .portada-velo {
    position: absolute;
    inset: 0;
  }

  .portada-fondo {
    z-index: -2;
  }

  .portada-fondo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La puerta de salida y el reloj están en el centro de la foto. */
    object-position: 50% 40%;
  }

  .portada-velo {
    z-index: -1;
    overflow: hidden;
    background:
      var(--tema-grano),
      radial-gradient(ellipse at center, rgb(0 0 0 / 0%) 45%, rgb(0 0 0 / 60%) 100%),
      linear-gradient(180deg, rgb(20 17 13 / 72%) 0%, rgb(20 17 13 / 84%) 55%, rgb(20 17 13 / 94%));
  }

  /* La linterna: un círculo cálido que se pasea muy despacio por la portería. */
  .portada-velo::before {
    content: '';
    position: absolute;
    inset: -15%;
    background: var(--tema-linterna);
    animation: portada-linterna 26s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes portada-linterna {
    0% {
      transform: translate(-6%, 2%);
    }

    50% {
      transform: translate(4%, -3%);
    }

    100% {
      transform: translate(-12%, 4%);
    }
  }

  /* ---------- Contenido ---------- */

  .portada-contenido {
    box-sizing: border-box;
    width: min(100%, 76rem);
    margin: 0 auto;
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: max(1.25rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(0.75rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
  }

  .portada-relato > * {
    margin: 0;
  }

  .portada-ante {
    color: var(--tema-claro-suave);
  }

  .portada-reloj {
    margin-top: 0.75rem;
    font-family: var(--tema-letra-maquina);
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--tema-ambar);
    text-shadow:
      0 0 14px rgb(242 169 59 / 55%),
      0 0 40px rgb(242 169 59 / 25%);
  }

  .portada-segundos {
    font-size: max(14px, 0.45em);
    color: var(--tema-ambar-brillo);
  }

  .portada-dos-puntos {
    animation: portada-parpadeo 1s steps(1, end) infinite;
  }

  @keyframes portada-parpadeo {
    50% {
      opacity: 0.2;
    }
  }

  .portada-titulo {
    margin-top: 0.5rem;
    font-size: clamp(2.5rem, 12vw, 3.5rem);
    line-height: 1.02;
  }

  .portada-gancho {
    margin-top: 0.875rem;
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--tema-claro);
  }

  .portada-datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .portada-datos li {
    padding: 4px 10px;
    border: 1px solid rgb(242 169 59 / 45%);
    border-radius: var(--tema-radio);
    background: rgb(0 0 0 / 45%);
    color: var(--tema-claro);
    line-height: 1.35;
    letter-spacing: 0.06em;
  }

  /* ---------- El tráiler ---------- */

  .portada-trailer-abrir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.75rem;
    padding: 0 14px;
    border: 1px solid var(--tema-ambar);
    border-radius: var(--tema-radio);
    background: rgb(0 0 0 / 55%);
    color: var(--tema-ambar-brillo);
    font-family: var(--tema-letra-maquina);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .portada-trailer-abrir:hover {
    background: rgb(242 169 59 / 18%);
  }

  .portada-trailer-abrir:focus-visible {
    outline: 3px solid var(--tema-claro);
    outline-offset: 3px;
  }

  .portada-trailer-dur {
    color: var(--tema-claro-suave);
    font-weight: 400;
  }

  .portada-trailer {
    width: min(100vw - 2rem, 72rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--tema-noche-borde);
    border-radius: var(--tema-radio);
    background: var(--tema-noche);
  }

  .portada-trailer::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .portada-trailer-caja {
    display: grid;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  .portada-trailer-video {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 2rem - 4.5rem);
    background: #000;
  }

  .portada-trailer-cerrar {
    justify-self: end;
  }

  @media (orientation: portrait) {
    .portada-trailer {
      width: min(100vw - 1rem, 30rem);
    }
  }

  /* ---------- La ficha del expediente ---------- */

  .portada-contenido :global(.portada-ficha) {
    width: 100%;
    max-width: 26rem;
    /* El texto empieza bajo el margen rojo de la ficha (a 2,6 rem) y va sobre los renglones. */
    padding-top: 2.6rem;
    animation-delay: 120ms;
  }

  .portada-contenido :global(.portada-sello) {
    position: absolute;
    top: 0;
    right: 14px;
    pointer-events: none;
    /* Golpea cuando la ficha ya está en su sitio. */
    animation-delay: 500ms;
  }

  .portada-ficha-nota {
    margin: 0 0 0.875rem;
    color: var(--tema-tinta-suave);
    font-size: 0.9375rem;
    line-height: 1.75rem;
  }

  .portada-acciones {
    display: grid;
    gap: 0.75rem;
  }

  .portada-jugar {
    min-height: 64px;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .portada-docentes {
    min-height: 48px;
  }

  .portada-pie {
    align-self: end;
  }

  .portada-pie p {
    margin: 0;
    color: var(--tema-claro-suave);
    font-size: 0.875rem;
  }

  /* ---------- Vertical: una columna, «Jugar» a la vista ---------- */

  @media (orientation: portrait) {
    .portada-contenido {
      gap: 1rem;
    }

    .portada-contenido :global(.portada-ficha) {
      max-width: none;
      margin-top: 1.25rem;
    }

    .portada-ficha-nota {
      display: none;
    }

    .portada-datos {
      margin-top: 0.75rem;
      gap: 0.375rem;
    }
  }

  /* ---------- Horizontal y computador: dos columnas ---------- */

  @media (orientation: landscape) {
    .portada-velo {
      background:
        var(--tema-grano),
        radial-gradient(ellipse at center, rgb(0 0 0 / 0%) 50%, rgb(0 0 0 / 55%) 100%),
        linear-gradient(
          90deg,
          rgb(20 17 13 / 93%) 0%,
          rgb(20 17 13 / 82%) 45%,
          rgb(20 17 13 / 60%) 75%,
          rgb(20 17 13 / 72%) 100%
        );
    }

    .portada-contenido {
      grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.9fr);
      align-items: center;
      column-gap: clamp(1.5rem, 4vw, 4rem);
      row-gap: 0.75rem;
      padding-top: max(clamp(1rem, 4vh, 3rem), env(safe-area-inset-top));
      padding-right: max(clamp(1.25rem, 4vw, 3rem), env(safe-area-inset-right));
      padding-left: max(clamp(1.25rem, 4vw, 3rem), env(safe-area-inset-left));
    }

    .portada-contenido :global(.portada-ficha) {
      justify-self: end;
    }

    .portada-pie {
      grid-column: 1 / -1;
    }

    /* El tamaño sigue a lo que falte primero: el ancho o el alto (celular en horizontal). */
    .portada-reloj {
      margin-top: clamp(0.25rem, 2vh, 1rem);
      font-size: clamp(1.75rem, min(5vw, 9vh), 4.5rem);
    }

    .portada-titulo {
      margin-top: clamp(0.25rem, 1.5vh, 0.75rem);
      font-size: clamp(2rem, min(6.2vw, 11vh), 6rem);
    }

    .portada-gancho {
      margin-top: clamp(0.5rem, 2vh, 1.25rem);
      font-size: clamp(0.9375rem, min(1.7vw, 3.9vh), 1.25rem);
    }

    .portada-datos {
      margin-top: clamp(0.625rem, 2.5vh, 1.5rem);
    }
  }

  /* Celular en horizontal: poco alto, todo más junto. */
  @media (orientation: landscape) and (max-height: 500px) {
    .portada-contenido {
      row-gap: 0.25rem;
    }

    .portada-contenido :global(.portada-ficha) {
      padding: 2.6rem 14px 14px;
    }

    .portada-ficha-nota {
      margin-bottom: 0.5rem;
    }

    .portada-datos {
      gap: 0.375rem;
    }

    .portada-datos li {
      padding: 2px 8px;
    }
  }

  /* Computador: la ficha y los textos crecen con la pantalla. */
  @media (orientation: landscape) and (min-width: 1200px) and (min-height: 700px) {
    .portada-ante,
    .portada-datos li,
    .portada-pie p {
      font-size: 1rem;
    }

    .portada-contenido :global(.portada-ficha) {
      max-width: 30rem;
      padding: 2.6rem 24px 24px;
    }

    .portada-ficha-nota {
      font-size: 1.0625rem;
    }

    .portada-jugar {
      min-height: 76px;
      font-size: 1.875rem;
    }

    .portada-docentes {
      min-height: 56px;
      font-size: 1.125rem;
    }
  }

  /* ---------- Menos movimiento ---------- */

  @media (prefers-reduced-motion: reduce) {
    .portada-velo::before,
    .portada-dos-puntos {
      animation: none;
    }
  }
</style>
