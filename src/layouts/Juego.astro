---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <!--
      viewport-fit=cover: el canvas ocupa también la zona del notch y de la barra de gestos.
      El HUD se aleja de esas zonas con env(safe-area-inset-*).
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111418" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: system-ui, sans-serif;
    background: #111418;
    color: #f2f2f2;
  }
  /* La página de juego nunca hace scroll, ni rebota, ni hace zoom con gestos. */
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
  body {
    background: #111418;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
  }
</style>
