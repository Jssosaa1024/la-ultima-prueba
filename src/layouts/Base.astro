---
import Pwa from './Pwa.astro';

interface Props {
  title: string;
  /** Resumen para buscadores y para la vista previa al compartir el enlace. */
  description?: string;
  /**
   * Imagen para compartir (Open Graph y Twitter), con ruta del sitio (`/portada/…`). Si se da,
   * la página lleva las etiquetas `og:*` y `twitter:*` con la URL absoluta del sitio.
   */
  imagen?: string;
  /** Texto alternativo de `imagen`. */
  imagenAlt?: string;
  /** Color de la barra del navegador en Android. */
  temaColor?: string;
}

const DESCRIPCION =
  'Escape room 3D de matemáticas para estudiantes de grado 9 en adelante: cinco salas, cinco máquinas y 40 minutos. Se juega en el navegador del celular, solo o en grupo.';

const {
  title,
  description = DESCRIPCION,
  imagen,
  imagenAlt = '',
  temaColor = '#111418',
} = Astro.props;
// `site` está en astro.config.mjs: las redes sociales solo leen imágenes con URL absoluta.
const absoluta = (ruta: string): string => new URL(ruta, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={temaColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {imagen && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:site_name" content="La Última Prueba" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={absoluta(Astro.url.pathname)} />
        <meta property="og:image" content={absoluta(imagen)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imagenAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluta(imagen)} />
        <meta name="twitter:image:alt" content={imagenAlt} />
      </>
    )}
    <Pwa />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: system-ui, sans-serif;
  }
  body {
    margin: 0;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    background: #111418;
    color: #f2f2f2;
  }
</style>
